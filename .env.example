# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server (optional)
PORT=3001

# Dev access (LOCAL ONLY — never set on a deployed environment)
# When both are set and NODE_ENV != production, a request with
# `Authorization: Bearer <DEV_ACCESS_TOKEN>` acts as the existing user DEV_USER_ID.
# Generate a token with: openssl rand -hex 24
DEV_ACCESS_TOKEN=
DEV_USER_ID=

# Snap / Vision AI (required for POST /api/snap). Pick ONE backend:
#
# (a) EASIEST — Gemini API key from https://aistudio.google.com/apikey (free tier, no GCP billing).
GEMINI_API_KEY=
#
# (b) Vertex AI via service account (needs billing enabled on the GCP project).
#     Path may be relative to this folder; ./gcp-key.json is used as a fallback if set path is missing.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GCP_PROJECT_ID=your-gcp-project
GCP_LOCATION=us-central1
#
# Optional: model order (comma-separated). Default (verified on a free key, Sept 2026):
#   gemini-3.5-flash → gemini-3.6-flash → gemini-3.5-flash-lite
# The 2.5 family is no longer available to new keys. On a 429 the model is cooled
# down 5 min and the request hops to the next. Put gemini-3.5-flash-lite first to
# stretch free quota at some accuracy cost.
GEMINI_MODELS=

# Snap cost controls (keep the app inside the free quota). Reset daily at midnight CT.
SNAP_DAILY_LIMIT=30          # per user (or IP if anonymous)
SNAP_GLOBAL_DAILY_LIMIT=900  # whole app
